# Discord (sin estos dos, arranca el REPL local)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ID=

# Persistencia: con GOOGLE_CLOUD_PROJECT usa Firestore; si no, ficheros JSON en DATA_DIR
GOOGLE_CLOUD_PROJECT=
DATA_DIR=./data/local

CAMPAIGN_ID=demo

# Fase 2
ANTHROPIC_API_KEY=

# Máster: live (API real) | offline (sin API) | record (API y guarda respuestas) | replay (solo caché)
MASTER_MODE=live
# Modelo y esfuerzo de pruebas; si van vacíos manda la campaña (claude-opus-5, low)
MASTER_MODEL=
MASTER_EFFORT=
# Actor de los NPC en las charlas: vacío = Sonnet 5.5; off lo apaga (docs/CONVERSACION.md)
ACTOR_MODEL=
ACTOR_EFFORT=
# Caché de respuestas para record/replay (por defecto data/local/master-cache)
MASTER_CACHE_DIR=
# Índice de reglas generado con `npm run rules:ingest` (por defecto data/local/rules)
RULES_DIR=

# Web: puerto de `npm run web`
WEB_PORT=3000

# Narrador de voz (docs/NARRADOR-VOZ.md). browser = la voz del navegador (gratis); azure o elevenlabs = nube.
TTS_PROVIDER=browser
# ElevenLabs: tu clave de API y, opcionales, el modelo y los ids de las voces (narrador y lista para personajes)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_VOICE_NARRATOR=
TTS_VOICES_NPC=
# Velocidad (1 = normal) y tope de caracteres enviados a la nube por arranque (lo cacheado no cuenta)
TTS_RATE=1
TTS_MAX_CHARS=200000
