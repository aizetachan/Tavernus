# Copia este fichero como deploy/local.env (ignorado por git) y pon tu servidor.
# Lo leen deploy/push.sh, deploy/push.ps1 y deploy/data-sync.sh.
#
# Quién despliega: el usuario tavernus, sin root (ver «Desplegar sin root» en el README).
# Mientras no esté preparado, root o un usuario con sudo también valen.
TAVERNUS_HOST=tavernus@203.0.113.7
TAVERNUS_SSH_PORT=22
# TAVERNUS_SSH_KEY=~/.ssh/tavernus_pc
#
# Administración: --setup, --ops, --usuario-deploy y data-sync.sh (copias y restauraciones).
# Si no se pone, se usan TAVERNUS_HOST y TAVERNUS_SSH_KEY.
# TAVERNUS_ADMIN_HOST=root@203.0.113.7
# TAVERNUS_ADMIN_SSH_KEY=~/.ssh/tavernus_admin
