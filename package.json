{
  "name": "tavernus",
  "version": "0.1.0",
  "private": true,
  "description": "D&D multijugador por chat con Master IA — motor de juego",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "web": "node --env-file-if-exists=.env --import tsx src/index.ts --web",
    "web:watch": "node --watch --watch-preserve-output --env-file-if-exists=.env --import tsx src/index.ts --web",
    "web:offline": "node --import tsx scripts/web.ts offline",
    "web:haiku": "node --import tsx scripts/web.ts haiku",
    "rules:ingest": "node --import tsx scripts/ingest-rules.ts",
    "bench": "node --env-file-if-exists=.env --import tsx scripts/model-bench.ts",
    "bench:report": "node --import tsx scripts/bench-report.ts",
    "bench:creativity": "node --env-file-if-exists=.env --import tsx scripts/creativity-bench.ts",
    "autoplay": "node --env-file-if-exists=.env --import tsx scripts/autoplay.ts",
    "judge": "node --env-file-if-exists=.env --import tsx scripts/judge.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pdfjs-dist": "^4.10.38",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "word-list": "^4.1.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google-cloud/firestore": "^9.0.1"
  }
}
